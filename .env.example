# Variables para docker-compose.yml (servicios dicom-analyzer / dicom-analyzer-api)
# Copiar a .env y completar. Este archivo de ejemplo sí se versiona; .env nunca.

# Carpeta local con los estudios DICOM a analizar (se monta de solo lectura)
DICOM_DATA_DIR=/ruta/a/tus/estudios

# Cantidad de archivos DICOM que procesa dicom-analyzer-api por lote
INGEST_BLOCK_SIZE=50
